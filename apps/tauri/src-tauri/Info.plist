<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's own by Tauri's bundler. App Transport Security would stop the webview loading
     pages over plain HTTP: the hub's, on this computer (loopback), and a shared host's that is not on
     HTTPS, which the Electron app could join. The window shows nothing else (main.rs's on_navigation). -->
<plist version="1.0">
<dict>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
  </dict>
</dict>
</plist>
